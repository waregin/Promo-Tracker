{
  "manifest_version": 3,
  "name": "Promo Tracker",
  "version": "1.0.0",
  "description": "Stores your promo codes and badges the tab when you are on a site you have one for.",
  "browser_specific_settings": {
    "gecko": {
      "id": "promo-tracker@waregin",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "background": {
    "scripts": [
      "src/background/main.js"
    ],
    "service_worker": "src/background/main.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Promo Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/page/page.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Promo Tracker"
    }
  }
}
