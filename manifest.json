{
  "manifest_version": 3,
  "name": "Promo Tracker",
  "version": "1.0.0",
  "description": "Stores your promo codes and badges the tab when you are on a site you have one for.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Promo Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/page/page.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Promo Tracker"
    }
  }
}
